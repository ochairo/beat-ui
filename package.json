{
  "name": "@ochairo/beat-ui",
  "version": "1.6.10",
  "description": "UI component catalog and foundations for Beat applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/**/*.js",
    "dist/**/*.css",
    "dist/**/*.d.ts",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm clean && vite build && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm test && pnpm typecheck && pnpm build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "beat-ui",
    "beat",
    "pulse",
    "ui",
    "components",
    "ochairo"
  ],
  "author": "ochairo",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ochairo/beat-ui"
  },
  "homepage": "https://ochairo.github.io/beat-site/",
  "bugs": {
    "url": "https://github.com/ochairo/beat-ui/issues"
  },
  "dependencies": {
    "@ochairo/beat": "^1.6.10",
    "@ochairo/numbers": "^1.6.10",
    "@ochairo/pulse": "^1.6.10",
    "@ochairo/scales": "^1.6.10"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  }
}
