{
  "name": "@ochairo/beat-ui",
  "version": "0.0.1",
  "description": "UI component catalog and foundations for Beat applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm clean && tsc && pnpm build:minify",
    "build:minify": "esbuild dist/index.js --outdir=dist --format=esm --allow-overwrite --minify --legal-comments=none --tree-shaking=true",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm test && pnpm typecheck && pnpm build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "beat-ui",
    "beat",
    "pulse",
    "ui",
    "components",
    "ochairo"
  ],
  "author": "ochairo",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ochairo/beat-ui"
  },
  "homepage": "https://github.com/ochairo/beat-ui#readme",
  "bugs": {
    "url": "https://github.com/ochairo/beat-ui/issues"
  },
  "dependencies": {
    "@ochairo/beat": "^1.1.2",
    "@ochairo/numbers": "^0.1.0",
    "@ochairo/pulse": "^1.1.1",
    "@ochairo/scales": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "esbuild": "^0.27.2",
    "happy-dom": "^20.0.7",
    "typescript": "^5.3.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.0.0"
  }
}
